# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
PORT=5000

# MongoDB Atlas Connection
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bus_tracker?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=bus_tracker

# Local Database Cache / Fallback
DATABASE_URL=sqlite:///d:/tracking/data/bus_tracker.db

# AI Recognition Thresholds
SIMILARITY_HIGH_THRESHOLD=0.72
SIMILARITY_MEDIUM_THRESHOLD=0.58
SIMILARITY_LOW_THRESHOLD=0.45
MIN_FACE_SIZE=30
BLUR_THRESHOLD=60.0

# Temporal Tracking Thresholds
MISSED_OBSERVATIONS_FOR_EXIT_UNCONFIRMED=3
MISSED_MINUTES_FOR_EXIT_UNCONFIRMED=5

# Data Privacy & Retention
ENABLE_DATA_RETENTION_CLEANUP=True
RETENTION_DAYS=30
ANONYMIZE_FACE_CROPS=False
DEMO_MODE=False
